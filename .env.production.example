DASHSCOPE_API_KEY=replace_with_dashscope_api_key
QWEN_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=
# 需与 embedding 提供方实际输出维度一致（text-embedding-v4 = 2048）；切换提供方时同步评估 pgvector embedding_vec 列宽与回填脚本。
EMBEDDING_DIMENSIONS=2048
EMBEDDING_REQUIRE_MODEL_MATCH=true
# 向量检索后端：pgvector | sqlite — 公网部署窗口验证后切换
VECTOR_SEARCH_BACKEND=sqlite
# 混合检索融合策略：weighted（默认，bm25/vector 归一化分数 0.6/0.4 加权）| rrf（可选）；切换条件见 docs/experiments/rag-fusion-comparison.md
HYBRID_FUSION_MODE=weighted
DASHSCOPE_RERANK_MODEL=qwen3-rerank
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
# 结构化输出通道：chain（默认，三段降级链）| legacy（仅旧 JSON 通道）
LLM_STRUCTURED_OUTPUT=chain

SECRET_KEY=replace_with_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

POSTGRES_DB=ai_interview
POSTGRES_USER=ai_interview
POSTGRES_PASSWORD=replace_with_postgres_password
DATABASE_URL=postgresql+psycopg://ai_interview:replace_with_postgres_password@db:5432/ai_interview
AUTO_INIT_DB=false

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

# MCP 检索工具开关（默认 false 关闭）：开启前确认 compose 内 mcp 服务可达；
# MCP_SERVER_URL 指向 compose 服务名（app 容器内解析 http://mcp:8000/mcp）。
MCP_TOOLS_ENABLED=false
MCP_SERVER_URL=http://mcp:8000/mcp

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false
