DASHSCOPE_API_KEY=your_dashscope_api_key
QWEN_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=
# 需与 embedding 提供方实际输出维度一致（text-embedding-v4 = 2048）；切换提供方时同步评估 pgvector embedding_vec 列宽与回填脚本。
EMBEDDING_DIMENSIONS=2048
EMBEDDING_REQUIRE_MODEL_MATCH=true
# 向量检索后端：pgvector | sqlite — 公网部署窗口验证后切换
VECTOR_SEARCH_BACKEND=sqlite
# 混合检索融合策略：weighted（默认，bm25/vector 归一化分数 0.6/0.4 加权）| rrf（可选）；切换条件见 docs/experiments/rag-fusion-comparison.md
HYBRID_FUSION_MODE=weighted
DASHSCOPE_RERANK_MODEL=qwen3-rerank
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
# 结构化输出通道：chain（默认，三段降级链）| legacy（仅旧 JSON 通道）
LLM_STRUCTURED_OUTPUT=chain
SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Local default keeps development simple.
DATABASE_URL=sqlite:///data/app.db
AUTO_INIT_DB=true

# PostgreSQL example for deployment; not required for local development.
# DATABASE_URL=postgresql+psycopg://ai_interview:your_password@127.0.0.1:5432/ai_interview

# MySQL is useful for learning, but PostgreSQL remains the recommended production target for this project.
# DATABASE_URL=mysql+pymysql://ai_interview:your_password@127.0.0.1:3306/ai_interview

# Redis is optional in local development. Keep disabled unless you intentionally start Redis.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Celery uses eager mode locally so tests do not need a running worker.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=true
